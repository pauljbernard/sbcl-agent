(asdf:defsystem "sbcl-agent"
  :description "An environment based agentic first development enviornment"
  :author "Paul Bernard"
  :license "Apache-2.0"
  :version "0.1.0"
  :serial nil
  :depends-on ()
  :components
  ((:module "core-model"
    :pathname "src/"
    :serial t
    :components ((:file "bootstrap-runtime")
                 (:file "package")
                 (:file "trust-boundaries")
                 (:file "calculator")
                 (:file "config")
                 (:file "json")
                 (:file "provider-protocol")
                 (:file "provider-transport")
                 (:file "provider-transport-curl")
                 (:file "retrieval-intent")
                 (:file "retrieval-plan")
                 (:file "retrieval-ranking")
                 (:file "retrieval-dossier")
                 (:file "retrieval-service")
                 (:file "alignment-state")
                 (:file "reconciliation-decision")
                 (:file "reasoning-brief")
                 (:file "planning-brief")
                 (:file "outcome-brief")
                 (:file "prior-outcome-reuse")
                 (:file "cognition-bundle")
                 (:file "request-snapshot-model")
                 (:file "request-snapshot-cache")
                 (:file "request-planning-context")
                 (:file "provider-environment-context")
                 (:file "request-snapshot")
                 (:file "provider-mock")
                 (:file "provider-openai")
                 (:file "commands")
                 (:file "events")
                 (:file "conversation")
                 (:file "policy")
                 (:file "session")
                 (:file "traceability")
                 (:file "intents")
                 (:file "projects")
                 (:file "environment-core")
                 (:file "runtime-state")
                 (:file "conversation-state")
                 (:file "workflow-state")
                 (:file "artifact-state")
                 (:file "environment-sync")
                 (:file "environment-summary")
                 (:file "environment-store")
                 (:file "environment-compatibility")
                 (:file "environment")
                 (:file "workflow")
                 (:file "plans")
                 (:file "work-items-model")
                 (:file "work-items")
                 (:file "integration-rgp")
                 (:file "incidents")
                 (:file "sandbox")
                 (:file "tools-registry")
                 (:file "tools-fs")
                 (:file "tools-session")
                 (:file "tools-desktop")
                 (:file "tools-runtime")
                 (:file "tools-calculator")
                 (:file "tools-editor")
                 (:file "tools-project")
                 (:file "tools-docs")
                 (:file "tools-process")
                 (:file "tools-git")
                 (:file "patch")
                 (:file "tasks")
                 (:file "desktop-task-protocol")
                 (:file "actor-registry")
                 (:file "capability-registry")))
   (:module "service-core-stack"
    :pathname "src/"
    :depends-on ("core-model")
    :serial t
    :components ((:file "planning-service")
                 (:file "mutation-engine")
                 (:file "service-core")
                 (:file "execution-registry-core")
                 (:file "environment-image-service")
                 (:file "environment-service")
                 (:file "conversation-service")
                 (:file "memory-service")
                 (:file "runtime-service")
                 (:file "calculator-service")
                 (:file "package-management-service")
                 (:file "runtime-telemetry-service")
                 (:file "console-service")
                 (:file "workflow-service")
                 (:file "approval-service")))
   (:module "desktop-task-stack"
    :pathname "src/"
    :depends-on ("service-core-stack")
    :serial t
    :components ((:file "desktop-task-mailboxes")
                 (:file "desktop-task-interface")
                 (:file "desktop-task-supervision")
                 (:file "desktop-task-actor-system")
                 (:file "desktop-task-context-chat")
                 (:file "desktop-task-admin-surface")
                 (:file "desktop-task-service")
                 (:file "concurrency-core")
                 (:file "actor-runtime")))
   (:module "application-surface"
    :pathname "src/"
    :depends-on ("desktop-task-stack")
    :serial t
    :components ((:file "session-service")
                 (:file "intent-service")
                 (:file "project-service")
                 (:file "work-item-service")
                 (:file "reconciliation-execution-service")
                 (:file "incident-service")
                 (:file "trace-service")
                 (:file "task-service")
                 (:file "worker-service")
                 (:file "workflow-ops-service")
                 (:file "rgp-service")
                 (:file "mutation-review-service")
                 (:file "event-service")
                 (:file "execution-service")
                 (:file "platform-service")
                 (:file "turn-orchestrator")
                 (:file "execution-handle-service")
                 (:file "shell-service")
                 (:file "shell")
                 (:file "repl")
                 (:file "main"))))
  :in-order-to ((asdf:test-op (asdf:test-op "sbcl-agent/tests"))))

(asdf:defsystem "sbcl-agent/tests"
  :description "Base test suite for sbcl-agent."
  :author "Paul Bernard"
  :license "Apache-2.0"
  :depends-on ("sbcl-agent")
  :serial t
  :components ((:file "tests/package")
               (:file "tests/support")
               (:file "tests/provider-support")
               (:file "tests/concurrency")
               (:file "tests/smoke")
               (:file "tests/actor-system")
               (:file "tests/provider-context")
               (:file "tests/agent-intent")
               (:file "tests/retrieval")
               (:file "tests/evals")
               (:file "tests/service-contracts")
               (:file "tests/test-runner")
               (:file "tests/performance"))
  :perform (asdf:test-op (op c)
             (declare (ignore op c))
             (uiop:symbol-call :sbcl-agent/tests :run-all-tests)))
