        :key (lambda (entry) (getf entry :id))
        :test #'eq))

(defun run-catalog-test-case (case)
  (let* ((name (catalog-case-name case))
         (category (catalog-case-category case))
         (thunk (catalog-case-thunk case))
         (started (get-internal-real-time)))
    (unwind-protect
         (handler-case
             (progn
               (funcall thunk)
               (let ((duration (/ (- (get-internal-real-time) started)
                                  internal-time-units-per-second)))
                 (format t "PASS [~(~A~)] ~A~%" category name)
                 (list :name name
                       :category category
                       :status :passed
                       :duration-seconds duration)))
           (error (condition)
             (let ((duration (/ (- (get-internal-real-time) started)
                                internal-time-units-per-second)))
               (format t "FAIL [~(~A~)] ~A~%" category name)
               (list :name name
                     :category category
                     :status :failed
                     :duration-seconds duration
                     :error (princ-to-string condition)))))
      (ignore-errors
        (sb-ext:gc :full t)))))

(defun summarize-test-results (results)
  (let* ((total (length results))
         (passed (count :passed results :key (lambda (entry) (getf entry :status)) :test #'eq))
         (failed (count :failed results :key (lambda (entry) (getf entry :status)) :test #'eq))
         (duration (reduce #'+ results
                           :key (lambda (entry) (or (getf entry :duration-seconds) 0.0))
                           :initial-value 0.0))
         (categories (remove-duplicates (mapcar (lambda (entry) (getf entry :category)) results)
                                        :test #'eq))
         (category-summaries
           (mapcar (lambda (category)
                     (let* ((entries (remove-if-not (lambda (entry)
                                                      (eq category (getf entry :category)))
                                                    results))
                            (entry-total (length entries))
                            (entry-passed (count :passed entries :key (lambda (entry) (getf entry :status)) :test #'eq))
                            (entry-failed (count :failed entries :key (lambda (entry) (getf entry :status)) :test #'eq))
                            (entry-duration (reduce #'+ entries
                                                    :key (lambda (entry) (or (getf entry :duration-seconds) 0.0))
                                                    :initial-value 0.0)))
                       (list :category category
                             :total entry-total
                             :passed entry-passed
                             :failed entry-failed
                             :duration-seconds entry-duration)))
                   categories)))
    (list :total total
          :passed passed
          :failed failed
          :duration-seconds duration
          :categories category-summaries)))

(defun generate-test-program-report (results)
  (list :generated-at (get-universal-time)
        :suite-id :sbcl-agent
        :summary (summarize-test-results results)
        :results results
        :harnesses (available-test-harnesses)))

(defun ensure-test-report-directory ()
  (let ((root (merge-pathnames #P"tmp/test-results/"
                               (uiop:ensure-directory-pathname
                                (uiop:getcwd)))))
    (ensure-directories-exist root)
    root))

(defun write-test-report-json (report)
  (let* ((root (ensure-test-report-directory))
         (path (merge-pathnames #P"latest-report.json" root)))
    (with-open-file (stream path
                            :direction :output
                            :if-exists :supersede
                            :if-does-not-exist :create)
      (write-string (sbcl-agent::emit-json
                     (sbcl-agent::platform-json-safe-value report))
                    stream))
    path))

(defun write-test-report-markdown (report)
  (let* ((root (ensure-test-report-directory))
         (path (merge-pathnames #P"latest-report.md" root))
         (summary (getf report :summary)))
    (with-open-file (stream path
                            :direction :output
                            :if-exists :supersede
                            :if-does-not-exist :create)
      (format stream "# sbcl-agent Test Program Report~%~%")
      (format stream "- Generated at: ~A~%" (getf report :generated-at))
      (format stream "- Total tests: ~D~%" (or (getf summary :total) 0))
      (format stream "- Passed: ~D~%" (or (getf summary :passed) 0))
      (format stream "- Failed: ~D~%" (or (getf summary :failed) 0))
      (format stream "- Duration seconds: ~,3F~%~%" (or (getf summary :duration-seconds) 0.0))
      (format stream "## Categories~%~%")
      (dolist (entry (or (getf summary :categories) '()))
        (format stream "- `~(~A~)`: total=~D passed=~D failed=~D duration=~,3Fs~%"
                (getf entry :category)
                (or (getf entry :total) 0)
                (or (getf entry :passed) 0)
                (or (getf entry :failed) 0)
                (or (getf entry :duration-seconds) 0.0)))
      (format stream "~%## Harnesses~%~%")
      (dolist (entry (or (getf report :harnesses) '()))
        (format stream "- `~(~A~)`: ~A via `~A`~%"
                (getf entry :id)
                (or (getf entry :label) "")
                (or (getf entry :entrypoint) "")))
      (format stream "~%## Failures~%~%")
      (let ((failures (remove :failed (getf report :results)
                              :key (lambda (entry) (getf entry :status))
                              :test-not #'eq)))
        (if failures
            (dolist (entry failures)
              (format stream "- `~A` (`~(~A~)`): ~A~%"
                      (getf entry :name)
                      (getf entry :category)
                      (or (getf entry :error) "Unknown failure")))
            (format stream "- None~%"))))
    path))

(defun run-test-program (&key stop-on-failure)
  (run-test-program-category :categories (all-test-categories)
                             :stop-on-failure stop-on-failure))

(defun run-test-program-category (&key categories stop-on-failure)
  (let ((results '()))
    (dolist (case (filter-test-cases-by-categories
                   (or categories (all-test-categories))))
      (let ((result (run-catalog-test-case case)))
        (push result results)
        (when (and stop-on-failure
                   (eq :failed (getf result :status)))
          (error "~A" (or (getf result :error)
                          (format nil "Test ~A failed" (getf result :name)))))))
    (nreverse results)))

(defun run-and-write-test-report ()
  (format t "Running sbcl-agent categorized test program...~%")
  (let* ((results (run-test-program :stop-on-failure nil))
         (report (generate-test-program-report results))
         (json-path (write-test-report-json report))
         (markdown-path (write-test-report-markdown report))
         (summary (getf report :summary)))
    (format t "test-report> total=~D passed=~D failed=~D duration=~,3Fs~%"
            (or (getf summary :total) 0)
            (or (getf summary :passed) 0)
            (or (getf summary :failed) 0)
            (or (getf summary :duration-seconds) 0.0))
    (format t "test-report/json> ~A~%" (namestring json-path))
    (format t "test-report/markdown> ~A~%" (namestring markdown-path))
    report))

(defun run-and-write-test-report-for-categories (categories)
  (format t "Running sbcl-agent focused test program for ~{~A~^, ~}...~%"
          categories)
  (let* ((results (run-test-program-category :categories categories
                                             :stop-on-failure nil))
         (report (generate-test-program-report results))
         (json-path (write-test-report-json report))
         (markdown-path (write-test-report-markdown report))
         (summary (getf report :summary)))
    (format t "test-report> total=~D passed=~D failed=~D duration=~,3Fs~%"
            (or (getf summary :total) 0)
            (or (getf summary :passed) 0)
            (or (getf summary :failed) 0)
            (or (getf summary :duration-seconds) 0.0))
    (format t "test-report/json> ~A~%" (namestring json-path))
    (format t "test-report/markdown> ~A~%" (namestring markdown-path))
    report))

(defun run-and-write-test-report-for-harness (harness-id)
  (let ((harness (find-test-harness harness-id)))
    (unless harness
      (error "Unknown test harness ~A" harness-id))
    (let ((categories (getf harness :categories)))
      (if categories
          (run-and-write-test-report-for-categories categories)
          (run-and-write-test-report)))))

