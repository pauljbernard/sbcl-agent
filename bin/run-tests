#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

exec env XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/common-lisp-cache}" \
  sbcl --dynamic-space-size 4096 \
       --non-interactive \
       --eval '(require :asdf)' \
       --load "${PROJECT_DIR}/sbcl-agent.asd" \
       --eval '(asdf:test-system :sbcl-agent)' \
       --eval '(sb-ext:exit :code 0)'
