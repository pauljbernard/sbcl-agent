(defun all-test-cases ()
  (append (annotate-test-cases :core-cli (core-and-cli-tests))
          (annotate-test-cases :provider-conversation (provider-and-conversation-tests))
          (annotate-test-cases :interaction-boundary (interaction-boundary-tests))
          (annotate-derived-test-cases #'extended-suite-test-category
                                       (extended-suite-tests))))

(defun all-test-categories ()
  (remove-duplicates (mapcar #'catalog-case-category (all-test-cases))
                     :test #'eq))

(defun normalize-test-category-token (token)
  (intern (string-upcase (string token)) "KEYWORD"))

(defun filter-test-cases-by-categories (categories)
  (let ((normalized (mapcar #'normalize-test-category-token categories)))
    (remove-if-not (lambda (case)
                     (member (catalog-case-category case) normalized :test #'eq))
                   (all-test-cases))))

