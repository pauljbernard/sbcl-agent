    (with-open-file (stream path
                            :direction :output
                            :if-exists :supersede
                            :if-does-not-exist :create)
      (format stream "# sbcl-agent Test Evidence Index~%~%")
      (format stream "- Generated at: ~A~%~%" (getf index :generated-at))
      (format stream "## Harnesses~%~%")
      (dolist (entry (getf index :harnesses))
        (format stream "- `~(~A~)`: ~A via `~A`~%"
                (getf entry :id)
                (or (getf entry :label) "")
                (or (getf entry :entrypoint) ""))
        (let ((categories (getf entry :categories)))
          (when categories
            (format stream "  categories: ~{`~(~A~)`~^, ~}~%"
                    categories))))
      (format stream "~%## Artifacts~%~%")
      (dolist (artifact '(:latest-report-json :latest-report-markdown :coverage-index))
        (format stream "- `~(~A~)`: ~A~%"
                artifact
                (or (getf (getf index :artifacts) artifact) "not generated"))))
    path))

(defun write-test-evidence-index ()
  (let* ((index (generate-test-evidence-index))
         (json-path (write-test-evidence-index-json index))
         (markdown-path (write-test-evidence-index-markdown index)))
    (format t "test-evidence/json> ~A~%" (namestring json-path))
    (format t "test-evidence/markdown> ~A~%" (namestring markdown-path))
    index))

(defun run-all-tests ()
  (format t "Running sbcl-agent test suite...~%")
  (run-test-program :stop-on-failure t)
  (format t "All tests passed.~%")
  t)
