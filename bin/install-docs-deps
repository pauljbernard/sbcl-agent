#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LOCAL_GEM_ROOT="$ROOT_DIR/vendor/gems"
HOMEBREW_RUBY_BIN="/opt/homebrew/opt/ruby/bin"

if [[ -d "$HOMEBREW_RUBY_BIN" ]]; then
  export PATH="$HOMEBREW_RUBY_BIN:$PATH"
fi

export GEM_HOME="$LOCAL_GEM_ROOT"
export GEM_PATH="$LOCAL_GEM_ROOT"
export PATH="$LOCAL_GEM_ROOT/bin:$PATH"

if ! command -v ruby >/dev/null 2>&1; then
  echo "ruby is required to install docs dependencies" >&2
  exit 1
fi

if ! command -v gem >/dev/null 2>&1; then
  echo "gem is required to install docs dependencies" >&2
  exit 1
fi

cd "$ROOT_DIR"

gem install --no-document \
  'base64' \
  'bigdecimal' \
  'csv' \
  'jekyll:~> 4.3' \
  'jekyll-sass-converter:~> 2.2' \
  'minima:~> 2.5' \
  'webrick:~> 1.8' \
  'ffi:< 1.17'
