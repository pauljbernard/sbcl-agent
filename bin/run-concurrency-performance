#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
PROJECT_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
ASDF_CACHE_DIR="$PROJECT_DIR/.asdf-cache/"

mkdir -p "$ASDF_CACHE_DIR"

exec env \
  XDG_CACHE_HOME="${XDG_CACHE_HOME:-/tmp/common-lisp-cache}" \
  ASDF_OUTPUT_TRANSLATIONS="$ASDF_CACHE_DIR:$ASDF_CACHE_DIR" \
  SBCL_AGENT_PERF_MAX_CONCURRENCY_CORE_DISPATCH_MS="${SBCL_AGENT_PERF_MAX_CONCURRENCY_CORE_DISPATCH_MS:-1}" \
  SBCL_AGENT_PERF_MAX_RUNTIME_EVAL_READ_MS="${SBCL_AGENT_PERF_MAX_RUNTIME_EVAL_READ_MS:-2}" \
  SBCL_AGENT_PERF_MAX_ACTOR_DISPATCH_MS="${SBCL_AGENT_PERF_MAX_ACTOR_DISPATCH_MS:-1}" \
  SBCL_AGENT_PERF_MAX_MIXED_LOAD_READ_MS="${SBCL_AGENT_PERF_MAX_MIXED_LOAD_READ_MS:-1}" \
  SBCL_AGENT_PERF_MAX_MIXED_LOAD_ACTOR_DISPATCH_MS="${SBCL_AGENT_PERF_MAX_MIXED_LOAD_ACTOR_DISPATCH_MS:-1}" \
  sbcl --dynamic-space-size 4096 \
       --non-interactive \
       --load "$PROJECT_DIR/scripts/run-concurrency-performance.lisp"
