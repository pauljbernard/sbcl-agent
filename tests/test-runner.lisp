(in-package #:sbcl-agent/tests)

(defun run-test-case (name thunk)
  (funcall thunk)
  (format t "PASS ~A~%" name))

(defun run-test-group (cases)
  (dolist (case cases)
    (run-test-case (first case) (second case))))

(defun annotate-test-cases (category cases)
  (mapcar (lambda (case)
            (list :name (first case)
                  :thunk (second case)
                  :category category))
          cases))

(defun annotate-derived-test-cases (classifier cases)
  (mapcar (lambda (case)
            (list :name (first case)
                  :thunk (second case)
                  :category (funcall classifier (first case))))
          cases))

(defun catalog-case-name (case)
  (getf case :name))

(defun catalog-case-thunk (case)
  (getf case :thunk))

(defun catalog-case-category (case)
  (getf case :category))

(defun test-name-contains-p (name needle)
  (not (null (search needle name :test #'char-equal))))

(defun extended-suite-test-category (name)
  (cond
    ((or (test-name-contains-p name "retrieval")
         (test-name-contains-p name "grounding")
         (test-name-contains-p name "memory")
         (test-name-contains-p name "playbook")
         (test-name-contains-p name "evaluation-harness")
         (test-name-contains-p name "outcome-brief")
         (test-name-contains-p name "reasoning-brief")
         (test-name-contains-p name "planning-brief"))
     :retrieval-and-memory)
    ((test-name-contains-p name "service-contract")
     :service-contracts)
    ((or (test-name-contains-p name "orchestration")
         (test-name-contains-p name "long-horizon")
         (test-name-contains-p name "decomposition")
         (test-name-contains-p name "turn-flow"))
     :orchestration-and-planning)
    ((or (test-name-contains-p name "task")
         (test-name-contains-p name "worker"))
     :task-and-worker-lifecycle)
    ((or (test-name-contains-p name "workflow")
         (test-name-contains-p name "work-item")
         (test-name-contains-p name "approval")
         (test-name-contains-p name "validator")
         (test-name-contains-p name "replay")
         (test-name-contains-p name "reconcile")
         (test-name-contains-p name "checkpoint")
         (test-name-contains-p name "why-waiting")
         (test-name-contains-p name "transaction-replay")
         (test-name-contains-p name "capability-policy")
         (test-name-contains-p name "capability-grant"))
     :workflow-and-governance)
    ((or (test-name-contains-p name "environment")
         (test-name-contains-p name "session")
         (test-name-contains-p name "persistence")
         (test-name-contains-p name "serializable")
         (test-name-contains-p name "load-"))
     :environment-and-persistence)
    ((or (test-name-contains-p name "runtime")
         (test-name-contains-p name "incident")
         (test-name-contains-p name "mutation-review")
         (test-name-contains-p name "recovery")
         (test-name-contains-p name "artifact"))
     :runtime-and-incidents)
    ((or (test-name-contains-p name "compatibility")
         (test-name-contains-p name "linux-app")
         (test-name-contains-p name "execution-shell")
         (test-name-contains-p name "shell-workspace")
         (test-name-contains-p name "operator-status")
         (test-name-contains-p name "doctor-command"))
     :shell-and-compatibility)
    ((or (test-name-contains-p name "list-tools")
         (test-name-contains-p name "docs-read")
         (test-name-contains-p name "fs-read")
         (test-name-contains-p name "proc-run")
         (test-name-contains-p name "approve-and-run-tool")
         (test-name-contains-p name "git-"))
     :tools-and-artifacts)
    (t
     :extended-suite)))

